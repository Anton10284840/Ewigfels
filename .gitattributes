# =====================================================================
# Ewigfels – .gitattributes
# Zeilenenden normalisieren, Binärdateien nie mergen/diffen.
# Git LFS ist vorbereitet, aber AUS: Content wird per .gitignore nicht
# versioniert (GitHub-Gratis-LFS ist zu klein). Wer später LFS nutzen
# will (z. B. eigener Server/Azure DevOps), entfernt die '#' unten.
# =====================================================================

* text=auto

# Text
*.cpp   text diff=cpp eol=crlf
*.h     text diff=cpp eol=crlf
*.cs    text diff=csharp eol=crlf
*.ini   text eol=crlf
*.uproject text eol=crlf
*.uplugin  text eol=crlf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.po    text eol=lf

# Binär (kein Diff/Merge)
*.uasset binary
*.umap   binary
*.fbx    binary
*.obj    binary
*.glb    binary
*.blend  binary
*.png    binary
*.jpg    binary
*.exr    binary
*.hdr    binary
*.tga    binary
*.wav    binary
*.ogg    binary
*.mp4    binary
*.safetensors binary

# --- Optional: Git LFS (bei Bedarf aktivieren, dann "git lfs install") ---
# *.uasset filter=lfs diff=lfs merge=lfs -text lockable
# *.umap   filter=lfs diff=lfs merge=lfs -text lockable
# *.fbx    filter=lfs diff=lfs merge=lfs -text
# *.png    filter=lfs diff=lfs merge=lfs -text
# *.wav    filter=lfs diff=lfs merge=lfs -text
