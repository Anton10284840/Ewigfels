            "de": "Leg dich schlafen",
            "en": "Go to sleep"
          }
        },
        {
          "id": "o_nym",
          "kind": "dialogue",
          "target": "D_M110_Nym",
          "text": {
            "de": "Hör der Stimme zu",
            "en": "Listen to the voice"
          }
        }
