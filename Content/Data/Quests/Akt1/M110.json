      "next": [
        {
          "stage": "s4_edda"
        }
      ]
    },
    {
      "id": "s4_edda",
      "text": {
        "de": "Fünf Uhr morgens. Edda wartet vor deinem Turm. Sie weiß, dass etwas passiert ist.",
        "en": "Five in the morning. Edda is waiting outside your tower. She knows something happened."
