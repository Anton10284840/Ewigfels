  "summary": {
    "de": "Das Jahr ist um. Beide Monde sind voll. In dieser Nacht spricht eine Stimme zu dir, und Edda wartet auf eine Antwort.",
    "en": "The year is over. Both moons are full. Tonight a voice speaks to you, and Edda is waiting for an answer."
  },
  "dialogues": [
    "D_M110_Freunde_Dach",
    "D_M110_Nym",
    "D_M110_Edda"
  ],
  "stages": [
    {
      "id": "s1_jahresakkord",
      "text": {
        "de": "Die Stimmprobe ist vorbei. Heute wird gezählt, welcher Turm den Jahresakkord spielt.",
        "en": "The exams are over. Today the towers' notes are counted to see who plays the Year Chord."
      },
      "objectives": [
        {
          "id": "o_halle",
          "kind": "reach",
          "target": "Grosse_Halle_Fest",
          "marker": "Grosse_Halle",
          "text": {
            "de": "Geh zum Jahresabschluss in die Große Halle",
            "en": "Go to the end-of-year feast in the Great Hall"
          }
        },
        {
          "id": "o_akkord",
          "kind": "cast",
          "target": "A_Jahresakkord",
          "text": {
            "de": "Sing den Jahresakkord mit",
            "en": "Sing along to the Year Chord"
          }
        }
      ],
      "next": [
        {
          "stage": "s2_dach"
        }
      ]
    },
    {
      "id": "s2_dach",
      "text": {
        "de": "Mondtau fällt nur in Doppelnächten. Deine Freunde warten auf dem Nordturm.",
        "en": "Moondew only falls on Double Nights. Your friends are waiting on the North Tower."
      },
      "objectives": [
        {
          "id": "o_dach",
          "kind": "dialogue",
          "target": "D_M110_Freunde_Dach",
          "marker": "Nordturm_Dach",
          "text": {
            "de": "Sammle mit deinen Freunden Mondtau",
            "en": "Gather moondew with your friends"
          }
        }
      ],
      "next": [
        {
          "stage": "s3_traum"
        }
      ]
    },
    {
      "id": "s3_traum",
      "text": {
        "de": "Schlaf in deinem Turmzimmer. Diesmal ist der Traum klar.",
        "en": "Sleep in your tower room. This time the dream is clear."
      },
      "objectives": [
        {
          "id": "o_schlafen",
          "kind": "interact",
          "target": "Bett_Turmzimmer",
          "marker": "Turmzimmer_Bett",
